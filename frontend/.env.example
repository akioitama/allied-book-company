# Environment
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public site URL (used by FormSubmit order emails)
NEXT_PUBLIC_SITE_URL=https://www.alliedbook.com

# Order notification emails (POST /api/orders). Configure ONE of the two:
# 1) Gmail SMTP — recommended: a Gmail account + App Password (2-Step Verification required)
GMAIL_USER= idaniyalkhan3@gmail.com
GMAIL_APP_PASSWORD= jrbz feyo bsgv isib
# 2) Resend (https://resend.com) — needs a verified sender domain
RESEND_API_KEY=
ORDER_FROM_EMAIL=
# Optional: where order emails go (comma-separated for several inboxes)
ORDER_NOTIFY_EMAIL=

# ── Upfront payment accounts (checkout → Upfront → JazzCash / Easypaisa / UBL) ──
# ADMIN: fill these in with the real details. While a value is empty the
# checkout shows "To be confirmed" for that field and the order email flags it,
# so customers are never told to pay into a guessed account.
NEXT_PUBLIC_PAY_JAZZCASH_TITLE=
NEXT_PUBLIC_PAY_JAZZCASH_NUMBER=
NEXT_PUBLIC_PAY_EASYPAISA_TITLE=
NEXT_PUBLIC_PAY_EASYPAISA_NUMBER=
NEXT_PUBLIC_PAY_UBL_TITLE=
NEXT_PUBLIC_PAY_UBL_NUMBER=
NEXT_PUBLIC_PAY_UBL_IBAN=
NEXT_PUBLIC_PAY_UBL_BRANCH=
